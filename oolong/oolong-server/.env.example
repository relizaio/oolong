# Server Configuration
PORT=3000

# Server Host URL
# Used in the .well-known/tea discovery endpoint
# This should be the public URL where the TEA API is accessible
SERVER_HOST=http://localhost:3000

# Advertised TEA API version. The server accepts only 1.0.0 or v1.0.0.
# Routes are mounted at /v1.0.0. .well-known/tea stays unversioned.
API_VERSION=v1.0.0

# Filesystem content root. Defaults to ../fixtures/tea-1.0.0 from the server cwd.
# CONTENT_DIR=../fixtures/tea-1.0.0

# HMAC key for opaque pagination tokens. Required unless PAGE_TOKEN_DEV_FALLBACK=true
# and NODE_ENV is not production. Do not set the fallback in deployment configs.
# PAGE_TOKEN_SECRET=
# PAGE_TOKEN_DEV_FALLBACK=true